{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": false,
  "extends": ["@filecoin-pay/configs/biome/base", "@filecoin-pay/configs/biome/react"],
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noRedundantRoles": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/theme-toggle.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNestedTernary": "off"
          }
        }
      }
    }
  ]
}
