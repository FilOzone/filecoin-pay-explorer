{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": false,
  "extends": ["@filecoin-pay/configs/biome/base", "@filecoin-pay/configs/biome/next"],
  "linter": {
    "rules": {
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/app/console/(console)/page.tsx",
        "src/app/error.tsx",
        "src/components/UserConsole/AddServiceDialog/index.tsx",
        "src/components/UserConsole/DepositDialog.tsx",
        "src/components/UserConsole/FundsSection/components/GuidedTopUpDialog.tsx",
        "src/components/UserConsole/FundsSection/components/RunwayCard.tsx",
        "src/components/UserConsole/FundsSection/components/SquidQuoteReview.tsx",
        "src/components/UserConsole/FundsSection/data/squid-acquisition.ts",
        "src/components/UserConsole/FundsSection/data/squid-quote.ts",
        "src/components/UserConsole/IncreaseApprovalDialog.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNestedTernary": "off"
          }
        }
      }
    }
  ]
}
