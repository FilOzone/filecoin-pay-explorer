# Set to true only when testing Privy's fiat onramp sandbox.
NEXT_PUBLIC_PRIVY_ONRAMP_SANDBOX=false
# Show the Coinbase estimate in Add funds. Real Apple Pay payments stay disabled.
NEXT_PUBLIC_COINBASE_GUEST_SANDBOX=false
# Enable identity tokens in the Privy app for the signed-in console estimate.
PRIVY_VERIFICATION_KEY=
# Server-side Live-environment CDP Secret API Key for sandbox requests.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional settings for the Coinbase payment sheet on one registered PR preview hostname.
COINBASE_SANDBOX_PREVIEW_HOST=
COINBASE_APPLE_PAY_DOMAIN_FILE_BASE64=
# Enable after Coinbase verifies the domain.
COINBASE_SANDBOX_PREVIEW_ENABLED=false
NEXT_PUBLIC_NOTIFICATIONS_ELIGIBLE_NETWORKS=mainnet
NEXT_PUBLIC_NOTIFICATIONS_API_URL=https://placeholder.invalid/notifications
