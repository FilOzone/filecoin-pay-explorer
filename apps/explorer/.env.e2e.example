# Copy to .env.e2e.local (gitignored). Needed only for `test:e2e:real`, which logs in to the staging
# Privy app with its test account (Privy dashboard: User management > Authentication > Advanced).
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
E2E_PRIVY_TEST_EMAIL=
E2E_PRIVY_TEST_OTP=

# Uncomment only if you always want `test:e2e` in real mode (staging Privy, live network) instead of the fakes.
# E2E_MODE=real
